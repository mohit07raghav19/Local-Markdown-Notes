{
  "manifest_version": 3,
  "name": "Local Markdown Notes",
  "version": "1.0",
  "description": "Take markdown notes with screenshots and YouTube timestamps, stored locally",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open Notes Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "capture-screenshot": {
      "suggested_key": {
        "default": "Alt+O",
        "mac": "Alt+O"
      },
      "description": "Capture screenshot of video or page"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon16.png",
    "128": "icon16.png"
  }
}
